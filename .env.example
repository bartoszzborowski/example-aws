# ------------------------------------------------------------
# Values injected at EC2 boot by user-data.sh via /run/app.env
# DO NOT place real secrets here.
# ------------------------------------------------------------

APP_NAME="Stream My Sport"
APP_ENV=production
APP_KEY=             # from SSM: /stream-my-sport/prod/app/APP_KEY
APP_DEBUG=false
APP_URL=https://example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# MySQL — DB_PASSWORD injected from Secrets Manager at boot
DB_CONNECTION=mysql
DB_HOST=             # injected by user-data (RDS endpoint)
DB_PORT=3306
DB_DATABASE=         # injected by user-data
DB_USERNAME=         # injected by user-data
DB_PASSWORD=         # injected from Secrets Manager at boot

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database

CACHE_STORE=database

# S3 — injected by user-data; EC2 IAM role used (no ACCESS_KEY needed)
AWS_DEFAULT_REGION=    # injected by user-data
AWS_BUCKET=            # injected by user-data
AWS_USE_PATH_STYLE_ENDPOINT=false

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=         # from SSM: /stream-my-sport/prod/app/MAILGUN_USERNAME
MAIL_PASSWORD=         # from SSM: /stream-my-sport/prod/app/MAILGUN_SECRET
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
